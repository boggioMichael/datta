{
  "name": "datta-site",
  "version": "1.0.0",
  "private": true,
  "description": "DATTA / דאטא — the public website of Michael Boggio's independent studio. Static site generated from Markdown/YAML content with React + TypeScript.",
  "type": "module",
  "scripts": {
    "build": "tsx build.ts",
    "dev": "tsx build.ts --watch --serve",
    "preview": "tsx build.ts --serve",
    "check": "tsc --noEmit",
    "validate": "tsx build.ts --validate",
    "screenshots": "node tools/screenshots.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0",
    "sharp": "^0.34.0"
  }
}
