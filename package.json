{
  "name": "datta-site",
  "version": "1.0.0",
  "private": true,
  "description": "DATTA / דאטא — the public website of Michael Boggio's independent studio. Static site generated from Markdown/YAML content with React + TypeScript.",
  "type": "module",
  "scripts": {
    "build": "tsx build.ts",
    "dev": "tsx build.ts --watch --serve",
    "preview": "tsx build.ts --serve",
    "check": "tsc --noEmit",
    "validate": "tsx build.ts --validate",
    "screenshots": "node tools/screenshots.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:studio": "npm --prefix studio test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.1.0",
    "katex": "^0.19.0",
    "marked": "^15.0.0",
    "mermaid": "^12.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vexflow": "^4.2.5"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0",
    "sharp": "^0.34.0"
  }
}
